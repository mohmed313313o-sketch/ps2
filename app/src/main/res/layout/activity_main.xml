<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060913"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBrandTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮 استوديو محنك PS2 الكامل"
                        android:textColor="#38BDF8"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBrandSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="ZSO • ART • POPS VCD • WinBin2Iso • OPL"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_btn_gradient"
                    android:paddingHorizontal="14dp"
                    android:text="☀️ فاتح"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRightsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="⚡ حقوق محنك PS2 | @muhanak_ps2"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/tabZso"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_btn_gradient"
                android:text="🗜️ ISO ➔ ZSO"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tabArt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card_dark"
                android:text="🖼️ أغلفة ART"
                android:textColor="#E2E8F0"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tabVcd"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card_dark"
                android:text="💿 PS1 ➔ VCD"
                android:textColor="#E2E8F0"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tabBin2Iso"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_card_dark"
                android:text="📀 WinBin2Iso"
                android:textColor="#E2E8F0"
                android:textStyle="bold" />
        </GridLayout>

        <LinearLayout
            android:id="@+id/toolCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvToolTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗜️ ضغط ألعاب PS2 من ISO إلى ZSO"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToolDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ضغط ملفات ISO بكتل 16KB باستخدام Zstandard لتشغيلها على OPL."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etInputPath"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_dark"
                    android:hint="اختر ملفاً أو اكتب كود اللعبة (SLUS_209.46)..."
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPickFile"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_dark"
                    android:paddingHorizontal="12dp"
                    android:text="📂 اختيار"
                    android:textColor="#38BDF8"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etOutputFolder"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_dark"
                android:hint="مجلد الحفظ"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnStartAction"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_gradient"
                android:text="🚀 تنفيذ العملية الآن"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/logCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#38BDF8" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="جاهز للعمل — استوديو محنك PS2"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConsole"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="#04070D"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:text="[نظام محنك PS2] جميع الأدوات جاهزة (ZSO + ART + VCD + BIN2ISO).&#10;"
                android:textColor="#34D399"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/footerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_dark"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© جميع الحقوق محفوظة لـ محنك PS2 (@muhanak_ps2)"
                android:textColor="#93C5FD"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
